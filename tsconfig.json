rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the resource belongs to the user
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && ('email' in request.auth.token) && request.auth.token.email == 'kojvhy@gmail.com';
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /chats/{chatId} {
      allow read, delete: if isAdmin() || isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isAdmin() || (isOwner(resource.data.userId) && isOwner(request.resource.data.userId));

      match /messages/{messageId} {
        function isParentOwner() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid;
        }

        allow read, create: if isAdmin() || (isAuthenticated() && isParentOwner());
        allow update, delete: if false; // Messages shouldn't be modified or deleted individually
      }
    }
  }
}
