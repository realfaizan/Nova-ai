import React, { useEffect, useState } from 'react';
import { db, auth } from '../lib/firebase';
import { collection, query, getDocs, orderBy, limit, doc, getDoc, deleteDoc, updateDoc } from 'firebase/firestore';
import { Shield, MessageSquare, Users, Clock, AlertCircle, X, ChevronLeft, Trash2, Archive } from 'lucide-react';
import ChatMessage from './ChatMessage';
import { Message } from '../types';

export default function AdminDashboard({ onClose }: { onClose: () => void }) {
  const [stats, setStats] = useState({ totalUsers: 0, totalChats: 0, totalMessages: 0 });
  const [recentChats, setRecentChats] = useState<any[]>([]);
  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  
  const [selectedChat, setSelectedChat] = useState<any | null>(null);
  const [chatMessages, setChatMessages] = useState<Message[]>([]);
  const [isLoadingMessages, setIsLoadingMessages] = useState(false);

  const fetchAdminData = async () => {
    try {
      setIsLoading(true);
      // We'll fetch all chats (limit to 50 for performance)
      const chatsRef = collection(db, 'chats');
      const q = query(chatsRef, orderBy('createdAt', 'desc'), limit(50));
      const snapshot = await getDocs(q);
      
      const fetchedChats = snapshot.docs.map(doc => ({ id: doc.id, ...(doc.data() as any) }));
      setRecentChats(fetchedChats);
      
      // Count basic stats
      setStats({
        totalUsers: Array.from(new Set(fetchedChats.map(c => c.userId))).length,
        totalChats: fetchedChats.length,
        totalMessages: 0 
      });
      
    } catch (err: any) {
      console.error('Error fetching admin data:', err);
      if (err.code === 'permission-denied') {
        setError('You do not have permission to view this dashboard. Please update Firestore rules.');
      } else {
        setError('Failed to load admin dashboard.');
      }
    } finally {
      setIsLoading(false);
    }
  };

  useEffect(() => {
    fetchAdminData();
  }, []);

  const handleViewLog = async (chat: any) => {
    setSelectedChat(chat);
    setIsLoadingMessages(true);
    try {
      const q = query(collection(db, `chats/${chat.id}/messages`), orderBy('timestamp', 'asc'));
      const snapshot = await getDocs(q);
      const messages = snapshot.docs.map(doc => ({
        id: doc.id,
        role: doc.data().role,
        content: doc.data().content,
        imageBase64: doc.data().imageBase64,
        timestamp: doc.data().timestamp?.toDate() || new Date(),
      })) as Message[];
      setChatMessages(messages);
    } catch (err) {
      console.error('Error fetching chat messages:', err);
      alert('Failed to load chat messages (Permission denied or network error)');
    } finally {
      setIsLoadingMessages(false);
    }
  };

  const handleDeleteChat = async (chatId: string) => {
    try {
      await deleteDoc(doc(db, 'chats', chatId));
      // Also fetch again to refresh list
      fetchAdminData();
    } catch (err) {
      console.error('Failed to delete chat:', err);
      alert('Failed to delete chat');
    }
  };

  const handleArchiveChat = async (chatId: string, currentArchivedStatus: boolean) => {
    try {
      await updateDoc(doc(db, 'chats', chatId), {
        isArchived: !currentArchivedStatus
      });
      fetchAdminData();
    } catch (err) {
      console.error('Failed to archive chat:', err);
      alert('Failed to archive chat');
    }
  };

  if (selectedChat) {
    return (
      <div className="flex-1 flex flex-col overflow-hidden bg-white/30 dark:bg-gray-900/30">
        <div className="flex items-center justify-between p-4 border-b border-white/20 dark:border-gray-700/30 bg-white/40 dark:bg-gray-800/40 backdrop-blur-md shrink-0">
          <div className="flex items-center gap-3">
            <button 
              onClick={() => setSelectedChat(null)}
              className="p-2 hover:bg-white/50 dark:hover:bg-gray-700/50 rounded-lg transition-colors text-gray-600 dark:text-gray-300"
            >
              <ChevronLeft size={20} />
            </button>
            <div>
              <h2 className="font-bold text-gray-900 dark:text-gray-100">{selectedChat.title}</h2>
              <p className="text-xs text-gray-500">Chat ID: {selectedChat.id} | User: {selectedChat.userId}</p>
            </div>
          </div>
        </div>
        <div className="flex-1 overflow-y-auto p-4 md:p-6">
          <div className="max-w-4xl mx-auto">
            {isLoadingMessages ? (
              <div className="flex justify-center p-8">
                <div className="w-8 h-8 border-4 border-purple-500/30 border-t-purple-500 rounded-full animate-spin" />
              </div>
            ) : chatMessages.length === 0 ? (
              <div className="text-center text-gray-500 p-8">No messages found in this chat.</div>
            ) : (
              <div className="space-y-4">
                {chatMessages.map(msg => (
                  <ChatMessage key={msg.id} message={msg} />
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className="flex-1 overflow-y-auto p-6 md:p-10 bg-white/30 dark:bg-gray-900/30">
      <div className="max-w-6xl mx-auto space-y-8">
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="w-12 h-12 bg-red-500/10 rounded-xl flex items-center justify-center text-red-600 dark:text-red-400">
              <Shield size={24} />
            </div>
            <div>
              <h1 className="text-2xl font-bold text-gray-900 dark:text-gray-100">Admin Dashboard</h1>
              <p className="text-gray-500 dark:text-gray-400">Monitor app usage and AI interactions</p>
            </div>
          </div>
          <button 
            onClick={onClose}
            className="px-4 py-2 bg-white/50 dark:bg-gray-800/50 hover:bg-white/80 dark:hover:bg-gray-700/80 rounded-lg text-sm font-medium transition-colors border border-white/40 dark:border-white/5"
          >
            Back to App
          </button>
        </div>

        {error && (
          <div className="p-4 bg-red-500/10 border border-red-500/20 rounded-xl flex items-center gap-3 text-red-600 dark:text-red-400">
            <AlertCircle size={20} />
            <p>{error}</p>
          </div>
        )}

        <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div className="bg-white/50 dark:bg-gray-800/50 backdrop-blur-sm border border-white/40 dark:border-white/5 p-6 rounded-2xl shadow-sm">
            <div className="flex items-center gap-3 mb-2 text-gray-500 dark:text-gray-400">
              <Users size={20} />
              <h3 className="font-medium">Active Users</h3>
            </div>
            <p className="text-3xl font-bold text-gray-900 dark:text-gray-100">{stats.totalUsers}</p>
            <p className="text-sm text-gray-400 mt-1">Based on recent chats</p>
          </div>
          <div className="bg-white/50 dark:bg-gray-800/50 backdrop-blur-sm border border-white/40 dark:border-white/5 p-6 rounded-2xl shadow-sm">
            <div className="flex items-center gap-3 mb-2 text-gray-500 dark:text-gray-400">
              <MessageSquare size={20} />
              <h3 className="font-medium">Recent Chats</h3>
            </div>
            <p className="text-3xl font-bold text-gray-900 dark:text-gray-100">{stats.totalChats}</p>
            <p className="text-sm text-gray-400 mt-1">Total tracked in view</p>
          </div>
          <div className="bg-white/50 dark:bg-gray-800/50 backdrop-blur-sm border border-white/40 dark:border-white/5 p-6 rounded-2xl shadow-sm">
            <div className="flex items-center gap-3 mb-2 text-gray-500 dark:text-gray-400">
              <Clock size={20} />
              <h3 className="font-medium">Status</h3>
            </div>
            <p className="text-3xl font-bold text-green-600 dark:text-green-400">Online</p>
            <p className="text-sm text-gray-400 mt-1">System operational</p>
          </div>
        </div>

        <div className="bg-white/50 dark:bg-gray-800/50 backdrop-blur-sm border border-white/40 dark:border-white/5 rounded-2xl shadow-sm overflow-hidden">
          <div className="p-6 border-b border-white/20 dark:border-gray-700/30">
            <h2 className="text-lg font-bold text-gray-900 dark:text-gray-100">Recent User Chats</h2>
          </div>
          <div className="overflow-x-auto">
            <table className="w-full text-left border-collapse">
              <thead>
                <tr className="bg-white/20 dark:bg-gray-900/20 text-gray-500 dark:text-gray-400 text-sm">
                  <th className="p-4 font-medium">Chat ID</th>
                  <th className="p-4 font-medium">User ID</th>
                  <th className="p-4 font-medium">Title</th>
                  <th className="p-4 font-medium">Created</th>
                  <th className="p-4 font-medium">Status</th>
                  <th className="p-4 font-medium text-right">Actions</th>
                </tr>
              </thead>
              <tbody className="text-sm">
                {isLoading ? (
                  <tr>
                    <td colSpan={6} className="p-8 text-center text-gray-500">Loading records...</td>
                  </tr>
                ) : recentChats.length === 0 ? (
                  <tr>
                    <td colSpan={6} className="p-8 text-center text-gray-500">No recent chats found.</td>
                  </tr>
                ) : (
                  recentChats.map((chat) => (
                    <tr key={chat.id} className={`border-b border-white/10 dark:border-gray-700/20 hover:bg-white/30 dark:hover:bg-gray-700/30 transition-colors ${chat.isArchived ? 'opacity-50' : 'text-gray-800 dark:text-gray-200'}`}>
                      <td className="p-4 font-mono text-xs">{chat.id.slice(0,8)}...</td>
                      <td className="p-4 font-mono text-xs">{chat.userId.slice(0,8)}...</td>
                      <td className="p-4 max-w-xs truncate">{chat.title}</td>
                      <td className="p-4 text-gray-500">
                        {chat.createdAt ? new Date(chat.createdAt.toMillis()).toLocaleString() : 'N/A'}
                      </td>
                      <td className="p-4 text-gray-500">
                        {chat.isArchived ? <span className="bg-gray-200 dark:bg-gray-700 px-2 py-1 rounded text-xs">Archived</span> : <span className="bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 px-2 py-1 rounded text-xs">Active</span>}
                      </td>
                      <td className="p-4">
                        <div className="flex items-center justify-end gap-2">
                          <button 
                            onClick={() => handleViewLog(chat)}
                            className="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300 font-medium px-3 py-1.5 rounded-md hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-colors"
                          >
                            View
                          </button>
                          <button
                            onClick={() => handleArchiveChat(chat.id, !!chat.isArchived)}
                            className="p-1.5 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 rounded transition-colors"
                            title={chat.isArchived ? "Unarchive" : "Archive"}
                          >
                            <Archive size={16} />
                          </button>
                          <button
                            onClick={() => handleDeleteChat(chat.id)}
                            className="p-1.5 text-red-500 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300 hover:bg-red-50 dark:hover:bg-red-900/20 rounded transition-colors"
                            title="Delete"
                          >
                            <Trash2 size={16} />
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  );
}
